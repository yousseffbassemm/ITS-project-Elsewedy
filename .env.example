# ITS Traffic Analytics — configuration
# Copy to .env and adjust as needed.

# YOLO model weights (yolov8n.pt = fastest/CPU, yolov8s.pt = better accuracy)
ITS_MODEL=yolov8s.pt

# Inference image size (lower = faster on CPU)
ITS_IMGSZ=640

# Process every Nth frame (1 = every frame; increase to speed up CPU processing)
ITS_FRAME_STRIDE=1

# Detection confidence threshold
ITS_CONF=0.25

# Max upload size in MB
ITS_MAX_UPLOAD_MB=500

# Keep a vehicle's ID through occlusions (ByteTrack + re-identification).
# Turning this off lets a vehicle that is briefly lost return as a new vehicle.
ITS_STABLE_IDS=true

# Only track/annotate the analysed carriageway. This camera also sees the
# opposite carriageway, whose traffic cannot be counted but does consume IDs.
ITS_ROI_GATED=true

# --- Licence plates ---------------------------------------------------------
# Off by default: the plate pass costs a second inference per frame, which is
# felt on CPU. Detection and plate COLOUR work on ~20px plates; OCR needs ~100px
# (or ~65px via the --enhance fusion pipeline). Check a clip first with
#   python -m tools.plate_footage_check --videos yourclip.mp4
ITS_PLATES=false
ITS_PLATE_MODEL=models/plate_detect.pt

# Character-recognition weights for SINGLE-FRAME OCR. Leave empty for no OCR —
# the report then says so rather than leaving an unexplained empty column. The
# --enhance pipeline uses plate_alpr_model instead and ignores this.
ITS_PLATE_OCR_MODEL=

# --- ANPR cascade -----------------------------------------------------------
# vehicle -> plate -> characters + colour. This is the stage that actually READS
# plates; ITS_PLATES below is the cheaper colour-only path over the whole frame.
#
# Needs ~15px of CHARACTER height (not plate width). Check a clip first:
#   python -m tools.plate_footage_check --videos yourclip.mp4
# Below the floor it reports why per vehicle rather than inventing a number.
#
# Train the two stages with notebooks/train_all_colab.ipynb. Until then the
# pretrained stand-ins work: ITS_ANPR_STAGE2=models/plate_detect.pt and
# ITS_ANPR_STAGE3=models/eg_alpr.pt.
ITS_ANPR=false
ITS_ANPR_STAGE2=models/plate_on_vehicle.pt
ITS_ANPR_STAGE3=models/plate_chars.pt
# Run the cascade on every Nth observation of a track (2 extra inferences per
# vehicle per frame is felt on CPU; the per-track vote makes sampling ~free).
ITS_ANPR_EVERY=3

# --- Vehicle class ----------------------------------------------------------
# Second-stage classifier over each tracked crop, emitting A/C/D/E/G/V directly.
# Empty = the COCO size heuristic, which cannot express C (light truck) or V
# (van) and has no microbus concept at all. Train one with
# notebooks/vehicle_classes_colab.ipynb.
ITS_VEHICLE_CLS=
