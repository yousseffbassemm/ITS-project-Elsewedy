# Python
.venv/
__pycache__/
*.pyc
.env

# Data & model artifacts
data/jobs/*
*.tmp
!data/jobs/.gitkeep

# Harvested training crops. These are frames of real CCTV with LEGIBLE LICENCE
# PLATES — personal data. They must not be published, even to a private repo.
# Share them with annotators over an approved internal channel instead.
data/dataset/
# Downloaded plate datasets (EALPR etc). Real photographs of identifiable
# vehicles and readable plates — personal data under Egypt PDPL 151/2020, and
# ~600MB besides. Rebuild them with
#   git clone https://github.com/ahmedramadan96/EALPR data/plates/EALPR
#   python -m tools.ealpr_charmap && python -m tools.build_anpr_datasets
# never commit them, not even to a private repo.
data/plates/
# MIO-TCD (3.1 GB archive + the derived 7-class crop set). Photographs of
# identifiable vehicles, CC BY-NC-SA 4.0, and far too large for git. Rebuild
# with tools/prep_vehicle_dataset.py — the notebook does this itself on Colab.
data/vehicle_ext/
# YOLO weights live in the project root (Ultralytics downloads them there) as
# well as models/ — both must be ignored, they are ~30 MB.
*.pt
models/*.pt
samples/*.mp4
*.log
.playwright-mcp/
# Packaged crop sets for upload to a GPU host. Same personal data as
# data/dataset/ — just zipped, which makes it easier to move somewhere it
# should not go.
*_cls.zip
# Machine-local Claude Code settings; .claude/launch.json IS shared.
.claude/settings.local.json

# Colab code bundle — a build artefact, regenerate with tools/pack_for_colab.py
its_code_for_colab.zip
